# ---------------------------------------------------------------------------
# md-converter — environment template
# Copy to `.env` and adjust locally. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (local Postgres 17 already installed on host) ----------------
# Connection string used by Drizzle (Next.js) and SQLAlchemy (FastAPI/Celery).
DATABASE_URL=postgresql://donthenluyangenorsoro@localhost:5432/md-converter_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=md-converter_db
DB_USER=donthenluyangenorsoro
DB_PASSWORD=

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DATA_DIR=./data
MAX_FILE_SIZE_MB=100
MAX_JOB_SIZE_MB=500
MAX_FILES_PER_JOB=50
JOB_TIMEOUT_SECONDS=300

# --- Redis / Celery (containerised by docker-compose) ----------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Web (Next.js) ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000

# --- Converters ------------------------------------------------------------
MARKER_USE_GPU=false
MARKER_BATCH_SIZE=2
PANDOC_PATH=/usr/local/bin/pandoc

# --- Security --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
